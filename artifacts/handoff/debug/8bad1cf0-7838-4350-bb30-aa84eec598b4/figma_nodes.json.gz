"FRAME","scrollBehavior":"SCROLLS","children":[{"id":"75:27342","name":"yt-attributed-string","type":"FRAME","scrollBehavior":"SCROLLS","children":[{"id":"75:27343","name":"span","type":"FRAME","scrollBehavior":"SCROLLS","children":[{"id":"75:27344","name":"I really enjoyed thi","type":"TEXT","scrollBehavior":"SCROLLS","blendMode":"PASS_THROUGH","fills":[{"blendMode":"NORMAL","type":"SOLID","color":{"r":0.9450980424880981,"g":0.9450980424880981,"b":0.9450980424880981,"a":1}}],"strokes":[],"strokeWeight":1,"strokeAlign":"OUTSIDE","absoluteBoundingBox":{"x":1998.1639404296875,"y":11238.9921875,"width":1206.77294921875,"height":56.5},"absoluteRenderBounds":{"x":1998.5057373046875,"y":11239.3486328125,"width":1202.6671142578125,"height":53.630859375},"constraints":{"vertical":"TOP","horizontal":"LEFT"},"characters":"I really enjoyed this episode. There are other witnesses who came forward who you didn't mention like William Tompkins who was involved in designing the ships or Emery Smith who claims to be a prior medic in Space Warden. Each of their stories are unique. It makes you wonder. I personally didn't believe in UFOs in the media until I saw one in person. It made me have that \"OH Sh!÷!!!.. They ARE REAL!\" moment. ","characterStyleOverrides":[],"styleOverrideTable":{},"lineTypes":["NONE"],"lineIndentations":[0],"style":{"fontFamily":"Roboto","fontPostScriptName":null,"fontStyle":"Regular","fontWeight":400,"fontSize":14,"textAlignHorizontal":"LEFT","textAlignVertical":"BOTTOM","letterSpacing":0,"lineHeightPx":20,"lineHeightPercent":121.90476989746094,"lineHeightPercentFontSize":142.85714721679688,"lineHeightUnit":"PIXELS"},"layoutVersion":5,"effects":[],"interactions":[]},{"id":"75:27345","name":"span","type":"FRAME","scrollBehavior":"SCROLLS","children":[],"blendMode":"PASS_THROUGH","clipsContent":false,"background":[{"blendMode":"NORMAL","type":"SOLID","color":{"r":0.05882352963089943,"g":0.05882352963089943,"b":0.05882352963089943,"a":1}}],"fills":[{"blendMode
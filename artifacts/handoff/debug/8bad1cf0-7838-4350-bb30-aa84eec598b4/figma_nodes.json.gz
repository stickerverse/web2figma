ces. Hence they ‘stare’ at each other and connect.\nI cannot understand why you would make the shot if that’s not the reason.","characterStyleOverrides":[],"styleOverrideTable":{},"lineTypes":["NONE","NONE"],"lineIndentations":[0,0],"style":{"fontFamily":"Roboto","fontPostScriptName":null,"fontStyle":"Regular","fontWeight":400,"fontSize":14,"textAlignHorizontal":"LEFT","textAlignVertical":"BOTTOM","letterSpacing":0,"lineHeightPx":20,"lineHeightPercent":121.90476989746094,"lineHeightPercentFontSize":142.85714721679688,"lineHeightUnit":"PIXELS"},"layoutVersion":5,"effects":[],"interactions":[]}],"blendMode":"PASS_THROUGH","clipsContent":false,"background":[{"blendMode":"NORMAL","type":"SOLID","color":{"r":0.05882352963089943,"g":0.05882352963089943,"b":0.05882352963089943,"a":1}}],"fills":[{"blendMode":"NORMAL","type":"SOLID","color":{"r":0.05882352963089943,"g":0.05882352963089943,"b":0.05882352963089943,"a":1}}],"strokes":[],"strokeWeight":1,"strokeAlign":"INSIDE","backgroundColor":{"r":0.05882352963089943,"g":0.05882352963089943,"b":0.05882352963089943,"a":1},"absoluteBoundingBox":{"x":1998.1639404296875,"y":6184.9921875,"width":1191,"height":57},"absoluteRenderBounds":{"x":1998.1639404296875,"y":6184.9921875,"width":1191.0001220703125,"height":57},"constraints":{"vertical":"TOP","horizontal":"LEFT"},"effects":[],"interactions":[]}],"blendMode":"PASS_THROUGH","clipsContent":true,"background":[{"blendMode":"NORMAL","type":"SOLID","color":{"r":0.05882352963089943,"g":0.05882352963089943,"b":0.05882352963089943,"a":1}}],"fills":[{"blendMode":"NORMAL","type":"SOLID","color":{"r":0.05882352963089943,"g":0.05882352963089943,"b":0.05882352963089943,"a":1}}],"strokes":[],"strokeWeight":1,"strokeAlign":"INSIDE","backgroundColor":{"r":0.05882352963089943,"g":0.05882352963089943,"b":0.05882352963089943,"a":1},"absoluteBoundingBox":{"x":1998.1639404296875,"y":6183.4921875,"width":1207,"height":60},"absoluteRenderBounds":{"x":1998.1639404296875,"y":6183.4921875,"width":1207.000